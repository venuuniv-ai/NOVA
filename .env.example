# Local demonstration only. Do not reuse this password outside local development.
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_local_only
POSTGRES_DB=nova
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
# For running FastAPI outside Compose; containers use the postgres hostname.
DATABASE_URL=postgresql+psycopg://nova:nova_local_only@localhost:5432/nova
# Next.js forwards /api/* to FastAPI. This is server-side, not a public env var.
API_INTERNAL_URL=http://localhost:8000
ENABLE_EXTERNAL_MODEL_TESTS=false
DAILY_AI_BUDGET_USD=0
MAX_REQUEST_COST_USD=0

# Local proactive cooldown Redis (Docker Compose uses redis:6379).
REDIS_URL=redis://localhost:6379/0
